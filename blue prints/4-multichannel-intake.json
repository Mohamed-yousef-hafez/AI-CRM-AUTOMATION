{
  "name": "CRM 4 - Multi-channel Intake (WhatsApp / Facebook / Email)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": "<YOUR_WEBHOOK_ID>", "maxResults": 1 },
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 0 } }
    },
    {
      "id": 2,
      "module": "gemini-ai:simpleTextPrompt",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "gemini-2.5-flash",
        "textPrompt": "You are a B2B sales assistant. A potential customer sent a message through the channel '{{1.channel}}'. Extract the lead details from the message and evaluate the lead from 0 to 100 based on company size, job title seniority, budget and clarity of the request. Reply with ONE line only, in exactly this format: name|company|job_title|budget|score|category|reason|next_action . Use an empty value if a detail is unknown. The budget must be digits only (use 0 if unknown). The category must be Hot (score 70 or more), Warm (40 to 69) or Cold (below 40). The reason and next_action are one short English sentence each. Never use the | character inside a value. Do not add any other text. Sender: {{1.sender}}. Message: {{1.text}}"
      },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    },
    {
      "id": 3,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": { "datastore": "<YOUR_DATASTORE_ID>" },
      "mapper": {
        "key": "{{1.sender}}",
        "overwrite": true,
        "data": {
          "name": "{{trim(get(split(2.result; \"|\"); 1))}}",
          "company": "{{trim(get(split(2.result; \"|\"); 2))}}",
          "job_title": "{{trim(get(split(2.result; \"|\"); 3))}}",
          "budget": "{{trim(get(split(2.result; \"|\"); 4))}}",
          "value": "{{trim(get(split(2.result; \"|\"); 4))}}",
          "score": "{{trim(get(split(2.result; \"|\"); 5))}}",
          "category": "{{trim(get(split(2.result; \"|\"); 6))}}",
          "ai_reason": "{{trim(get(split(2.result; \"|\"); 7))}}",
          "next_action": "{{trim(get(split(2.result; \"|\"); 8))}}",
          "email": "{{if(contains(1.sender; \"@\"); 1.sender; \"\")}}",
          "phone": "{{if(contains(1.sender; \"@\"); \"\"; 1.sender)}}",
          "source": "{{1.channel}}",
          "message": "{{1.text}}",
          "status": "New",
          "owner": "{{if(trim(get(split(2.result; \"|\"); 6)) = \"Hot\"; \"Senior Sales\"; \"Sales Rep\")}}",
          "created_at": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
          "last_contact": "{{formatDate(now; \"YYYY-MM-DD\")}}"
        }
      },
      "metadata": { "designer": { "x": 600, "y": 0 } }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{\"result\":\"saved\",\"channel\":\"{{1.channel}}\",\"score\":{{trim(get(split(2.result; \"|\"); 5))}},\"category\":\"{{trim(get(split(2.result; \"|\"); 6))}}\"}"
      },
      "metadata": { "designer": { "x": 900, "y": 0 } }
    },
    {
      "id": 5,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": { "__IMTCONN__": "<YOUR_GMAIL_CONNECTION_ID>" },
      "filter": {
        "name": "Only Hot leads",
        "conditions": [[{ "a": "{{trim(get(split(2.result; \"|\"); 6))}}", "b": "Hot", "o": "text:equal" }]]
      },
      "mapper": {
        "to": ["<YOUR_EMAIL>"],
        "bodyType": "rawHtml",
        "subject": "Hot Lead via {{1.channel}}: {{trim(get(split(2.result; \"|\"); 1))}} - Score {{trim(get(split(2.result; \"|\"); 5))}}",
        "content": "<h2>New Hot Lead ({{1.channel}})</h2><p><b>Name:</b> {{trim(get(split(2.result; \"|\"); 1))}}<br><b>Company:</b> {{trim(get(split(2.result; \"|\"); 2))}}<br><b>Job title:</b> {{trim(get(split(2.result; \"|\"); 3))}}<br><b>Contact:</b> {{1.sender}}<br><b>Channel:</b> {{1.channel}}</p><p><b>AI Score:</b> {{trim(get(split(2.result; \"|\"); 5))}} (Hot)<br><b>Reason:</b> {{trim(get(split(2.result; \"|\"); 7))}}<br><b>Next action:</b> {{trim(get(split(2.result; \"|\"); 8))}}</p><p><b>Original message:</b> {{1.text}}</p>"
      },
      "metadata": { "designer": { "x": 1200, "y": 0 } }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false,
      "maxErrors": 3,
      "roundtrips": 1,
      "sequential": false
    }
  }
}
