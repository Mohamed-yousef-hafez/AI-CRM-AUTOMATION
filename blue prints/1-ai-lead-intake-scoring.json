{
  "name": "CRM 1 - AI Lead Intake & Scoring",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "<YOUR_WEBHOOK_ID>",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "gemini-ai:simpleTextPrompt",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "gemini-2.5-flash",
        "textPrompt": "You are a B2B sales expert. Evaluate this lead from 0 to 100 based on company size, job title seniority, budget and clarity of the request. Reply with ONE line only, in exactly this format: score|category|reason|next_action . The category must be Hot (score 70 or more), Warm (40 to 69) or Cold (below 40). The reason and next_action are one short English sentence each and must not contain the | character. Do not add any other text. Lead data: name={{1.name}}; company={{1.company}}; job title={{1.job_title}}; budget={{1.budget}}; source={{1.source}}; message={{1.message}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {
        "datastore": "<YOUR_DATASTORE_ID>"
      },
      "mapper": {
        "key": "{{1.email}}",
        "overwrite": true,
        "data": {
          "name": "{{1.name}}",
          "company": "{{1.company}}",
          "email": "{{1.email}}",
          "job_title": "{{1.job_title}}",
          "source": "{{1.source}}",
          "budget": "{{1.budget}}",
          "message": "{{1.message}}",
          "score": "{{trim(get(split(2.result; \"|\"); 1))}}",
          "category": "{{trim(get(split(2.result; \"|\"); 2))}}",
          "ai_reason": "{{trim(get(split(2.result; \"|\"); 3))}}",
          "next_action": "{{trim(get(split(2.result; \"|\"); 4))}}",
          "status": "New",
          "value": "{{1.budget}}",
          "owner": "{{if(trim(get(split(2.result; \"|\"); 2)) = \"Hot\"; \"Senior Sales\"; \"Sales Rep\")}}",
          "created_at": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
          "last_contact": "{{formatDate(now; \"YYYY-MM-DD\")}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{\"result\":\"saved\",\"score\":{{trim(get(split(2.result; \"|\"); 1))}},\"category\":\"{{trim(get(split(2.result; \"|\"); 2))}}\",\"reason\":\"{{trim(get(split(2.result; \"|\"); 3))}}\",\"next_action\":\"{{trim(get(split(2.result; \"|\"); 4))}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {
        "__IMTCONN__": "<YOUR_GMAIL_CONNECTION_ID>"
      },
      "filter": {
        "name": "Only Hot leads",
        "conditions": [
          [
            {
              "a": "{{trim(get(split(2.result; \"|\"); 2))}}",
              "b": "Hot",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "to": [
          "<YOUR_EMAIL>"
        ],
        "bodyType": "rawHtml",
        "subject": "Hot Lead: {{1.name}} ({{1.company}}) - Score {{trim(get(split(2.result; \"|\"); 1))}}",
        "content": "<h2>New Hot Lead</h2><p><b>Name:</b> {{1.name}}<br><b>Company:</b> {{1.company}}<br><b>Job title:</b> {{1.job_title}}<br><b>Email:</b> {{1.email}}<br><b>Budget:</b> {{1.budget}}<br><b>Source:</b> {{1.source}}</p><p><b>AI Score:</b> {{trim(get(split(2.result; \"|\"); 1))}} (Hot)<br><b>Reason:</b> {{trim(get(split(2.result; \"|\"); 3))}}<br><b>Next action:</b> {{trim(get(split(2.result; \"|\"); 4))}}</p>"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false,
      "maxErrors": 3,
      "roundtrips": 1,
      "sequential": false
    }
  }
}